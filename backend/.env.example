# ADA Backend environment configuration
# Copy to .env and fill in real values. Never commit .env to git.

ADA_ENVIRONMENT=development
ADA_DEBUG=true
ADA_LOG_LEVEL=INFO

# Server
ADA_HOST=0.0.0.0
ADA_PORT=8000
ADA_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Security — generate a strong random key for production
ADA_SECRET_KEY=dev-secret-key-change-in-production-must-be-32-chars-minimum

# Supabase — get these from your Supabase project dashboard
ADA_SUPABASE_URL=https://your-project.supabase.co
ADA_SUPABASE_ANON_KEY=your-anon-key
ADA_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose to clients

# Database (for LangGraph checkpointer — use Supabase connection pooler URL)
ADA_DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Model Providers — configure the ones you want to use
ADA_GEMINI_API_KEY=
ADA_GROQ_API_KEY=
ADA_OPENROUTER_API_KEY=
ADA_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Push Notifications (Firebase Cloud Messaging)
ADA_FCM_SERVER_KEY=
